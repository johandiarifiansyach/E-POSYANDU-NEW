# PostgreSQL connection string. Supabase: use the Transaction pooler or direct connection from Connect.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@HOST:5432/postgres

# Comma-separated frontend origins. Set the Netlify URL in production.
CORS_ORIGINS=http://localhost:5173,https://delicate-lolly-9a37f0.netlify.app

# Only enable locally when you intentionally want SQLAlchemy to create missing tables.
AUTO_CREATE_SCHEMA=false
