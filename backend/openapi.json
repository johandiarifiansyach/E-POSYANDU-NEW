{
  "openapi": "3.1.0",
  "info": {
    "title": "E-Posyandu Puskesmas Gumukmas API",
    "version": "3.5.4",
    "description": "REST API untuk autentikasi, CRUD, sinkronisasi, dan ekspor, serta endpoint GraphQL baca E-Posyandu."
  },
  "servers": [
    {
      "url": "https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Memeriksa kesehatan API",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "API aktif",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "summary": "Memeriksa kesiapan komponen operasional tanpa membaca data balita",
        "operationId": "readinessCheck",
        "responses": {
          "200": {
            "description": "Ringkasan kesiapan API, database, cache, Queue, R2, dan worker gRPC",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "Mengambil kontrak OpenAPI",
        "operationId": "openApiDocument",
        "responses": {
          "200": {
            "description": "Dokumen OpenAPI"
          }
        }
      }
    },
    "/api/v1/graphql": {
      "post": {
        "summary": "Menjalankan query GraphQL baca sesuai cakupan wilayah pengguna",
        "operationId": "graphQlQuery",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string" },
                  "variables": { "type": "object" },
                  "operationName": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Hasil query GraphQL atau error GraphQL terstruktur" },
          "401": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/graphql/schema": {
      "get": {
        "summary": "Mengambil schema GraphQL baca",
        "operationId": "graphQlSchema",
        "responses": {
          "200": { "description": "Schema Definition Language GraphQL" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Masuk memakai username dan kata sandi",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesi dan profil akses berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Mengambil profil dan cakupan akses",
        "operationId": "currentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil pengguna"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/features": {
      "get": {
        "summary": "Mengambil feature flag aktif",
        "operationId": "featureFlags",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar feature flag"
          }
        }
      }
    },
    "/api/v1/monitoring/status": {
      "get": {
        "summary": "Mengambil status worker dan kesiapan infrastruktur untuk Admin Gizi",
        "operationId": "monitoringStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status infrastruktur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoringStatus"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/dashboard/stats": {
      "get": {
        "summary": "Mengambil ringkasan dashboard sesuai wilayah pengguna",
        "operationId": "dashboardStats",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ringkasan dashboard"
          }
        }
      }
    },
    "/api/v1/children/page": {
      "get": {
        "summary": "Mengambil satu halaman daftar balita",
        "operationId": "childrenPage",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Halaman data balita"
          }
        }
      }
    },
    "/api/v1/exclusive-breastfeeding/page": {
      "get": {
        "summary": "Mengambil satu halaman data ASI eksklusif",
        "operationId": "exclusiveBreastfeedingPage",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Halaman data ASI eksklusif"
          }
        }
      }
    },
    "/api/v1/exports/sigizi-measurements": {
      "get": {
        "summary": "Mengambil data ekspor pengukuran Sigizi",
        "operationId": "sigiziMeasurementExport",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Baris data ekspor"
          }
        }
      }
    },
    "/api/v1/sync": {
      "post": {
        "summary": "Mengirim mutasi offline dan menarik perubahan server",
        "operationId": "synchronize",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Hasil sinkronisasi"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "summary": "Membuat pekerjaan berat untuk Queue dan gRPC worker",
        "operationId": "createBackgroundJob",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackgroundJobCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job masuk antrean",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundJob"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/jobs/{jobId}": {
      "get": {
        "summary": "Membaca progres dan hasil pekerjaan",
        "operationId": "getBackgroundJob",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundJob"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/jobs/{jobId}/file": {
      "get": {
        "summary": "Mengunduh hasil Excel atau PDF privat dari R2",
        "operationId": "downloadBackgroundJobFile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berkas hasil job"
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/v1/client-errors": {
      "post": {
        "summary": "Mencatat error teknis frontend tanpa data formulir",
        "operationId": "reportClientError",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Laporan diterima"
          }
        }
      }
    },
    "/api/v1/collections/{resource}": {
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "children",
              "measurements",
              "mpasi_logs",
              "pmt_programs",
              "change_logs"
            ]
          }
        }
      ],
      "get": {
        "summary": "Mengambil data koleksi sesuai cakupan akses",
        "operationId": "listCollection",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar dokumen"
          }
        }
      },
      "post": {
        "summary": "Menambahkan dokumen dengan idempotency key",
        "operationId": "createDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dokumen dibuat"
          }
        }
      }
    },
    "/api/v1/collections/{resource}/{id}": {
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Mengambil satu dokumen",
        "operationId": "getDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dokumen"
          }
        }
      },
      "patch": {
        "summary": "Memperbarui satu dokumen",
        "operationId": "updateDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dokumen diperbarui"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      },
      "delete": {
        "summary": "Menghapus satu dokumen",
        "operationId": "deleteDocument",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dokumen dihapus"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "service",
          "database",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["ok", "status", "checkedAt", "environment", "components"],
        "properties": {
          "ok": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["ready", "degraded", "not-ready"]
          },
          "checkedAt": { "type": "string", "format": "date-time" },
          "environment": { "type": "string" },
          "components": { "type": "object" }
        }
      },
      "MonitoringStatus": {
        "type": "object",
        "required": [
          "environment",
          "worker",
          "database",
          "storage",
          "queue",
          "alerts"
        ],
        "properties": {
          "environment": {
            "type": "string"
          },
          "worker": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["healthy", "degraded", "down", "unknown", "unconfigured"]
              },
              "checkedAt": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "latencyMs": {
                "type": ["integer", "null"]
              },
              "consecutiveFailures": {
                "type": "integer"
              }
            }
          },
          "database": {
            "type": "object"
          },
          "storage": {
            "type": "object",
            "properties": {
              "r2Configured": {
                "type": "boolean"
              },
              "status": {
                "type": ["object", "null"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["healthy", "cleaned", "warning"]
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "totalBytes": {
                    "type": "integer"
                  },
                  "temporaryBytes": {
                    "type": "integer"
                  },
                  "objectCount": {
                    "type": "integer"
                  },
                  "deletedObjects": {
                    "type": "integer"
                  },
                  "deletedBytes": {
                    "type": "integer"
                  },
                  "softLimitBytes": {
                    "type": "integer"
                  },
                  "cleanupTargetBytes": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "queue": {
            "type": "object"
          },
          "alerts": {
            "type": "object"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "turnstileToken": {
            "type": "string"
          }
        }
      },
      "AccessProfile": {
        "type": "object",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "desa": {
            "type": [
              "string",
              "null"
            ]
          },
          "posyandu": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "BackgroundJobCreate": {
        "type": "object",
        "required": [
          "kind",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "import_validation",
              "nutrition_report",
              "export_file",
              "system_sync"
            ]
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "BackgroundJob": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "downloadUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user",
          "profile"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "user": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "email"
              }
            }
          },
          "profile": {
            "$ref": "#/components/schemas/AccessProfile"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Permintaan ditolak",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
