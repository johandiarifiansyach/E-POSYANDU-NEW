# URL publik API Node, tanpa slash di akhir.
# Kosongkan saat API berada pada domain yang sama. Untuk Cloudflare Pages,
# isi dengan URL Worker, misalnya https://e-posyandu-api.<akun>.workers.dev.
VITE_API_URL=

# Publishable/anon key aman berada di frontend. Jangan gunakan service-role key di sini.
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_key_anda

# Opsional: site key Cloudflare Turnstile untuk verifikasi login tanpa CAPTCHA.
VITE_TURNSTILE_SITE_KEY=
