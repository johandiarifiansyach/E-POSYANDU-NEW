# Runtime credentials stay local. Commit the matching .env.example files instead.
.env
.env.*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example
frontend/.env
backend/.dev.vars

# Service-account credentials are never committed.
secrets/*.json
