{
  "name": "e-posyandu",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "check": "npm run standards:verify && npm run analysis:test && npm run frontend:check && npm run frontend:test && npm run replica:check && npm run integration:test && npm run worker:test && npm run grpc:test && npm run oracle:api:test && npm run microservices:test",
    "standards:verify": "node scripts/verify-who-standards.mjs",
    "frontend:check": "npm --prefix frontend run typecheck",
    "integration:test": "node --test tests/integration/*.test.mjs",
    "frontend:test": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.unit.config.ts",
    "e2e:test": "npm --prefix frontend run e2e:test",
    "ci": "npm run check && npm run build",
    "db:migrate": "./scripts/database/migrate.sh",
    "db:backup": "./scripts/database/backup.sh",
    "db:backup:verify": "./scripts/database/verify-backup.sh",
    "db:restore-drill": "./scripts/database/restore-drill.sh",
    "deployment:smoke": "node scripts/operations/smoke-deployment.mjs",
    "monitor:system": "node scripts/operations/monitor-system.mjs",
    "load:queue": "node scripts/operations/load-queue.mjs",
    "env:check": "./scripts/environment/check-database-isolation.sh",
    "r2:prepare": "./scripts/storage/prepare-r2.sh",
    "worker:check": "cargo check --manifest-path backend/Cargo.toml",
    "worker:test": "cargo test --manifest-path backend/Cargo.toml",
    "worker:dev": "npx --yes wrangler --cwd backend dev --env development --ip 127.0.0.1 --port 8787",
    "data-processing:check": "cargo check --manifest-path services/data-processing-service/Cargo.toml",
    "data-processing:test": "cargo test --manifest-path services/data-processing-service/Cargo.toml",
    "data-processing:build": "cargo build --locked --release --manifest-path services/data-processing-service/Cargo.toml",
    "data-processing:dev": "cargo run --manifest-path services/data-processing-service/Cargo.toml",
    "data-processing:load": "cargo run --locked --bin data-processing-load --manifest-path services/data-processing-service/Cargo.toml",
    "data-processing:check:cloud": "cargo check --locked --bin data-processing-cloud --manifest-path services/data-processing-service/Cargo.toml",
    "grpc:check": "npm run data-processing:check",
    "grpc:test": "npm run data-processing:test",
    "grpc:build": "npm run data-processing:build",
    "grpc:dev": "npm run data-processing:dev",
    "grpc:load": "npm run data-processing:load",
    "grpc:check:cloud": "npm run data-processing:check:cloud",
    "oracle:api:check": "cargo check --locked --manifest-path services/oracle-api/Cargo.toml",
    "oracle:api:test": "cargo test --locked --manifest-path services/oracle-api/Cargo.toml",
    "analysis:test": "python3 -m unittest discover -s services/analysis-service/tests -p 'test_*.py'",
    "microservices:test": "cargo test --locked --manifest-path services/identity-service/Cargo.toml && cargo test --locked --manifest-path services/operations-service/Cargo.toml && cargo test --locked --manifest-path services/realtime-service/Cargo.toml && cargo test --locked --manifest-path services/monitoring-service/Cargo.toml",
    "oracle:deploy": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:api": "./scripts/services/deploy-oracle-api.sh",
    "oracle:deploy:nutrition": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:data-processing": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:identity": "./scripts/services/deploy-oracle-identity.sh",
    "oracle:deploy:operations": "./scripts/services/deploy-oracle-operations.sh",
    "oracle:deploy:realtime": "./scripts/services/deploy-oracle-realtime.sh",
    "oracle:deploy:monitoring": "./scripts/services/deploy-oracle-monitoring.sh",
    "oracle:deploy:analysis": "./scripts/services/deploy-oracle-analysis.sh",
    "oracle:deploy:all": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:cutover:check": "./scripts/operations/check-oracle-cutover.sh",
    "replica:check": "npm --prefix services/neon-read-worker run typecheck",
    "replica:dev": "npm --prefix services/neon-read-worker run dev",
    "replica:bootstrap": "./scripts/database/bootstrap-neon-read-replica.sh",
    "replica:verify": "./scripts/database/verify-neon-read-replica.sh",
    "replica:deploy": "npm --prefix services/neon-read-worker run deploy",
    "replica:deploy:staging": "npm --prefix services/neon-read-worker run deploy:staging",
    "data-processing:connect:render": "./scripts/services/connect-render-data-processing.sh",
    "data-processing:deploy:oracle": "./scripts/services/deploy-oracle-data-processing.sh",
    "data-processing:connect:oracle": "./scripts/services/connect-oracle-data-processing.sh",
    "data-processing:activate:macos": "./scripts/services/activate-data-processing-worker-macos.sh",
    "data-processing:install:macos": "./scripts/services/install-data-processing-worker-macos.sh",
    "grpc:connect:render": "npm run data-processing:connect:render",
    "grpc:deploy:oracle": "npm run data-processing:deploy:oracle",
    "grpc:connect:oracle": "npm run data-processing:connect:oracle",
    "grpc:activate:macos": "npm run data-processing:activate:macos",
    "grpc:install:macos": "npm run data-processing:install:macos",
    "worker:deploy": "npx --yes wrangler --cwd backend deploy --env=",
    "worker:deploy:staging": "npx --yes wrangler --cwd backend deploy --env staging",
    "pages:build": "VITE_API_URL= npm --prefix frontend run build",
    "pages:build:staging": "VITE_APP_ENV=staging VITE_API_URL= npm --prefix frontend run build -- --mode staging",
    "pages:deploy": "npm run pages:build && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu --branch main",
    "pages:deploy:staging": "npm run pages:build:staging && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu-staging --branch staging",
    "preview": "npm --prefix frontend run preview"
  }
}
