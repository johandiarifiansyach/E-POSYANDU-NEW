{
  "name": "e-posyandu",
  "private": true,
  "version": "3.5.4",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "check": "npm run frontend:check && npm run integration:test && npm run worker:test && npm run grpc:test",
    "frontend:check": "npm --prefix frontend run typecheck",
    "integration:test": "node --test tests/integration/*.test.mjs",
    "e2e:test": "npm --prefix frontend run e2e:test",
    "ci": "npm run check && npm run build",
    "db:migrate": "./scripts/database/migrate.sh",
    "db:backup": "./scripts/database/backup.sh",
    "db:backup:verify": "./scripts/database/verify-backup.sh",
    "db:restore-drill": "./scripts/database/restore-drill.sh",
    "deployment:smoke": "node scripts/operations/smoke-deployment.mjs",
    "monitor:system": "node scripts/operations/monitor-system.mjs",
    "load:queue": "node scripts/operations/load-queue.mjs",
    "env:check": "./scripts/environment/check-database-isolation.sh",
    "r2:prepare": "./scripts/storage/prepare-r2.sh",
    "worker:check": "cargo check --manifest-path backend/Cargo.toml",
    "worker:test": "cargo test --manifest-path backend/Cargo.toml",
    "worker:dev": "npx --yes wrangler --cwd backend dev --env development --ip 127.0.0.1 --port 8787",
    "grpc:check": "cargo check --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:test": "cargo test --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:build": "cargo build --locked --release --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:dev": "cargo run --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:load": "cargo run --locked --bin nutrition-grpc-load --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:check:cloud": "cargo check --locked --bin nutrition-grpc-cloud --manifest-path services/nutrition-grpc/Cargo.toml",
    "grpc:connect:render": "./scripts/services/connect-render-nutrition-worker.sh",
    "grpc:activate:macos": "./scripts/services/activate-nutrition-grpc-macos.sh",
    "grpc:install:macos": "./scripts/services/install-nutrition-grpc-macos.sh",
    "worker:deploy": "npx --yes wrangler --cwd backend deploy --env=",
    "worker:deploy:staging": "npx --yes wrangler --cwd backend deploy --env staging",
    "pages:build": "VITE_API_URL=https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev npm --prefix frontend run build",
    "pages:build:staging": "VITE_APP_ENV=staging VITE_API_URL=https://e-posyandu-api-staging.eposyandu-puskesmas-gumukmas.workers.dev npm --prefix frontend run build -- --mode staging",
    "pages:deploy": "npm run pages:build && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu --branch main",
    "pages:deploy:staging": "npm run pages:build:staging && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu-staging --branch staging",
    "preview": "npm --prefix frontend run preview"
  }
}
