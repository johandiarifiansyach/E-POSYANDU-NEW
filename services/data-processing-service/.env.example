# Server gRPC privat. Gunakan UDS bila caller berada di host yang sama;
# gunakan http://HOST:PORT untuk caller lintas server/platform.
DATA_PROCESSING_GRPC_ADDR=unix:///tmp/e-posyandu/data-processing.sock
DATA_PROCESSING_GRPC_URL=unix:///tmp/e-posyandu/data-processing.sock
# Alamat listener worker yang dipakai Queue consumer; gunakan socket yang sama
# dengan DATA_PROCESSING_GRPC_ADDR pada deployment satu host.
# GRPC_ADDR/GRPC_URL tetap diterima sebagai alias kompatibilitas.
# Dibutuhkan untuk autentikasi metadata gRPC saat service dipanggil oleh API.
RUST_WORKER_SHARED_SECRET=replace-with-private-service-secret

# Biarkan false bila hanya ingin menjalankan server gRPC lokal.
QUEUE_CONSUMER_ENABLED=false
QUEUE_BATCH_SIZE=5
QUEUE_POLL_INTERVAL_MS=1500

# Wajib hanya ketika Queue consumer diaktifkan.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_QUEUE_ID=9ca1fbc52e5844d5b76b381ed302312a
CLOUDFLARE_QUEUES_API_TOKEN=replace-with-queues-edit-token
EPOSYANDU_API_URL=https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev
RUST_WORKER_SHARED_SECRET=replace-with-the-same-worker-secret
