# Server gRPC privat
GRPC_ADDR=127.0.0.1:50051
GRPC_URL=http://127.0.0.1:50051

# Biarkan false bila hanya ingin menjalankan server gRPC lokal.
QUEUE_CONSUMER_ENABLED=false
QUEUE_BATCH_SIZE=5
QUEUE_POLL_INTERVAL_MS=1500

# Wajib hanya ketika Queue consumer diaktifkan.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_QUEUE_ID=9ca1fbc52e5844d5b76b381ed302312a
CLOUDFLARE_QUEUES_API_TOKEN=replace-with-queues-edit-token
EPOSYANDU_API_URL=https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev
RUST_WORKER_SHARED_SECRET=replace-with-the-same-worker-secret
