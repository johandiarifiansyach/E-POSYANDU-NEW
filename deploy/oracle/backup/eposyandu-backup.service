[Unit]
Description=Create and upload encrypted E-Posyandu deployment backup
Wants=network-online.target
After=network-online.target eposyandu-vault-env.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock -n /run/lock/eposyandu-backup.lock /usr/local/libexec/e-posyandu/eposyandu-backup.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/e-posyandu/backup /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
TimeoutStartSec=5min

