# OCI Object Storage bucket created as private (never public).
OCI_BACKUP_BUCKET=eposyandu-oracle-backups
OCI_BACKUP_REGION=ap-batam-1
OCI_BACKUP_PREFIX=production/oracle
# Salinan dump database tidak dipertahankan melewati masa Recycle Bin.
# Nilai 30 hari memberi waktu pemulihan tanpa menyimpan data operasional lama.
OCI_BACKUP_RETENTION_DAYS=30

# OCID of a Vault secret containing a random client-side GPG passphrase.
# The secret value must never be committed to Git or pasted into chat.
OCI_BACKUP_ENCRYPTION_SECRET_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-backup-passphrase-secret

# Database PostgreSQL native yang disimpan oleh timer backup data terpisah.
OCI_POSTGRESQL_BACKUP_DATABASE=eposyandu
