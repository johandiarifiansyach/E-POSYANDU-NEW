# Non-secret OCI Vault configuration. Do not put secret values here.
OCI_VAULT_REGION=ap-batam-1
OCI_SECRET_CLOUDFLARE_QUEUES_API_TOKEN_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_RUST_WORKER_SHARED_SECRET_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
# Wajib diisi sebelum Compose profile `mcp` atau target mcp-service diaktifkan.
# Secret ini berbeda dari token gRPC service agar MCP dapat dicabut terpisah.
OCI_SECRET_MCP_SHARED_SECRET_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id

# Optional sampai Cloudflare Tunnel dibuat. Secret berisi token eyJ... dari
# perintah pemasangan Tunnel, bukan API token Cloudflare.
OCI_SECRET_CLOUDFLARE_TUNNEL_TOKEN_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id

# Cloudflare Origin CA untuk listener HTTPS internal health-proxy. Isi secret
# sebagai satu baris Base64 dari masing-masing file PEM (jangan simpan PEM atau
# private key langsung di file ini). Keduanya wajib diisi berpasangan.
OCI_SECRET_ORIGIN_CERT_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_ORIGIN_KEY_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id

# Isi kelimanya bersama-sama untuk mengaktifkan login/session native Oracle.
# Nilai aslinya tetap berada di Vault; file ini hanya menyimpan OCID secret.
OCI_SECRET_SUPABASE_URL_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_SUPABASE_PUBLISHABLE_KEY_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_SUPABASE_SECRET_KEY_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_TURNSTILE_SECRET_KEY_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id
OCI_SECRET_ORACLE_API_SESSION_KEY_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id

# Password role PostgreSQL native `eposyandu_api`. Script runtime menyusun URL
# lokal; nilai password tidak pernah disimpan pada file konfigurasi ini.
OCI_SECRET_ORACLE_DATABASE_PASSWORD_ID=ocid1.vaultsecret.oc1.ap-batam-1.replace-with-secret-id

# Endpoint PostgreSQL native. Default langsung ke PostgreSQL host. Setelah
# PgBouncer dipasang dan diuji, ubah port menjadi listener pooler (umumnya
# 6432); jangan mengubahnya sebelum health check database lulus.
ORACLE_DATABASE_HOST=host.containers.internal
ORACLE_DATABASE_PORT=5432
