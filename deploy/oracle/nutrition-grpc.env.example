# Host health check. Gunakan domain yang DNS-nya menunjuk ke IP publik Oracle
# agar Caddy memperoleh sertifikat HTTPS otomatis. Untuk uji sementara tanpa
# domain, nilai http://IP_PUBLIK dapat dipakai, tetapi jangan dijadikan kondisi akhir.
ORACLE_HEALTH_SITE=nutrition.example.go.id

# Origin API Oracle. Biarkan api.invalid selama tahap uji internal. Setelah DNS
# api.example.go.id mengarah ke Oracle, ganti dengan nama domain tersebut.
ORACLE_API_SITE=http://api.invalid
ORACLE_API_PUBLIC_ORIGIN=https://api.eposyandu.app
ORACLE_API_LEGACY_ORIGIN=https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev
ORACLE_API_TOKIO_WORKER_THREADS=
ORACLE_API_DATA_PROCESSING_GRPC_URL=unix:///run/e-posyandu/data-processing.sock
ORACLE_API_MICROSERVICES_ENABLED=true
ORACLE_API_IDENTITY_GRPC_URL=unix:///run/e-posyandu/identity.sock
# Read/write dipisah; OperationsService hanya untuk rollback profile legacy.
ORACLE_API_READ_GRPC_URL=unix:///run/e-posyandu/read.sock
ORACLE_API_WRITE_GRPC_URL=unix:///run/e-posyandu/write.sock
ORACLE_API_OPERATIONS_GRPC_URL=unix:///run/e-posyandu/operations.sock
ORACLE_API_REALTIME_GRPC_URL=unix:///run/e-posyandu/realtime.sock
ORACLE_API_MONITORING_GRPC_URL=unix:///run/e-posyandu/monitoring.sock
# Gateway readiness probes the analysis worker HTTP endpoint. Keep enabled in
# production so a missing analysis schema cannot be advertised as ready.
ORACLE_API_ANALYSIS_HEALTH_URL=http://analysis-worker:8082/ready
ORACLE_API_ANALYSIS_HEALTH_CHECK_ENABLED=true
ORACLE_API_MIGRATION_PROXY_ENABLED=false
# Keep the gateway session translator enabled while background jobs remain on
# the legacy Cloudflare Queue API. Reads and writes can still be staged off.
ORACLE_API_NATIVE_AUTH_ENABLED=true
ORACLE_API_NATIVE_READS_ENABLED=false
ORACLE_API_NATIVE_WRITES_ENABLED=false
ORACLE_API_CORS_ORIGINS=https://eposyandu.app,https://www.eposyandu.app
ORACLE_API_TURNSTILE_HOSTNAMES=eposyandu.app
ORACLE_API_LOG_LEVEL=e_posyandu_oracle_api=info,tower_http=info

# Budget koneksi role aplikasi native. Bootstrap menaikkan limit role secara
# idempoten bila limit lama terlalu kecil (tanpa pernah menurunkan limit yang
# sudah lebih tinggi atau unlimited). Sisakan slot untuk maintenance.
ORACLE_POSTGRES_API_ROLE_CONNECTION_LIMIT=40

# Dipakai juga oleh API Oracle untuk membuat background job secara native.
# Token Queue tetap diambil dari OCI Vault, bukan ditulis di file ini.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_QUEUE_ID=replace-with-cloudflare-queue-id

# Sebelum Tunnel aktif, origin masih boleh bind ke semua interface. Setelah
# public hostname Cloudflare Tunnel lulus smoke test, ubah menjadi 127.0.0.1
# dan hapus ingress publik OCI untuk 80/443. Mode fallback memakai HTTP privat
# health-proxy:8088; koneksi dari server ke edge tetap dienkripsi oleh Tunnel.
ORACLE_PUBLIC_BIND=0.0.0.0

# Kosong selama deployment langsung. Isi cloudflare-tunnel hanya setelah token
# Tunnel berada di OCI Vault dan route publik telah diarahkan ke
# http://health-proxy:8088. Origin CA dapat diaktifkan kemudian dengan mengisi
# kedua OCID Origin TLS pada deploy/oracle/vault/eposyandu-vault.env.
COMPOSE_PROFILES=

# Cloudflare Queue. Token Vault hanya memerlukan Account > Queues > Edit.
# CLOUDFLARE_QUEUES_API_TOKEN tidak boleh ditulis di file ini.

# Bridge internal untuk hasil job Queue/R2. Secret HMAC tetap hanya di Vault;
# RUST_WORKER_SHARED_SECRET tidak boleh ditulis di file ini.
EPOSYANDU_API_URL=https://e-posyandu-api.eposyandu-puskesmas-gumukmas.workers.dev

# Batas ringan untuk instance Always Free.
QUEUE_BATCH_SIZE=2
QUEUE_POLL_INTERVAL_MS=15000

# Worker Rust/PyO3 menyimpan hasil WHO/status ke PostgreSQL secara asinkron.
# URL database tetap berasal dari OCI Vault (ORACLE_DATABASE_URL); flag ini
# memulihkan job child yang gagal setelah gangguan migrasi/koneksi.
ANALYSIS_PERSISTENCE_ENABLED=true
ANALYSIS_REQUEUE_FAILED_ON_START=true
ANALYSIS_PERSISTENCE_WORKERS=2
# NumPy digunakan untuk batch numerik dan kurva grafik WHO bila tersedia.
ANALYSIS_NUMPY_ENABLED=true
# PyO3 tetap memakai thread (GIL tidak diakali dengan fork). Pada service
# Python standalone, set process setelah profiling untuk menjalankan beberapa
# proses dan mengatasi batas GIL.
ANALYSIS_DATASET_WORKER_MODE=thread
# PostgreSQL LISTEN/NOTIFY membangunkan scheduler; interval ini tetap menjadi
# safety-net. Satu wake memproses batch terbatas lalu job gagal memakai backoff.
ANALYSIS_PERSISTENCE_BATCH_SIZE=8
ANALYSIS_PERSISTENCE_INTERVAL_SECONDS=1
ANALYSIS_PERSISTENCE_RETRY_BASE_SECONDS=2
ANALYSIS_PERSISTENCE_RETRY_MAX_SECONDS=300

# MCP internal. Nilai MCP_SHARED_SECRET dan RUST_WORKER_SHARED_SECRET diisi
# melalui OCI Vault runtime env, bukan commit Git. mcp-service tidak
# dipublikasikan melalui Caddy/Cloudflare.
MCP_HTTP_ADDR=0.0.0.0:5160
MCP_READ_GRPC_URL=unix:///run/e-posyandu/read.sock
MCP_WRITE_GRPC_URL=unix:///run/e-posyandu/write.sock
MCP_ALLOWED_ORIGINS=https://eposyandu.app,https://www.eposyandu.app
# MCP_SHARED_SECRET=replace-with-vault-secret
