{
	admin off
}

(health_security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}
}

(api_security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

{$ORACLE_API_SITE:http://api.invalid} {
	@health path /health

	handle @health {
		reverse_proxy data-processing-worker:8080
		header Cache-Control "no-store"
		import health_security_headers
	}

	handle {
		reverse_proxy oracle-api:8081 {
			# Port publik masih dapat menerima trafik langsung selama transisi.
			# Jangan percaya header alamat Cloudflare dari koneksi yang belum
			# melalui Tunnel.
			header_up -CF-Connecting-IP
		}
		import api_security_headers
	}
}

# Listener ini hanya berada di jaringan Compose dan menjadi satu-satunya origin
# Cloudflare Tunnel. Setiap published hostname harus memakai service
# http://health-proxy:8088 serta HTTP Host Header yang sama dengan hostname-nya.
:8088 {
	@nutrition_health {
		host nutrition.eposyandu.app
		path /health
	}
	handle @nutrition_health {
		reverse_proxy data-processing-worker:8080
		header Cache-Control "no-store"
		import health_security_headers
	}

	@nutrition host nutrition.eposyandu.app
	handle @nutrition {
		import health_security_headers
		respond "Rute tidak ditemukan" 404
	}

	handle {
		# Listener internal Tunnel hanya meneruskan request ke API setelah
		# route Cloudflare memvalidasi hostname yang dipublikasikan.
		reverse_proxy oracle-api:8081
		import api_security_headers
	}
}
